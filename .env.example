# 后端服务端口
PORT=3000

# MySQL 连接串（本机 MySQL 8.0.36 实例，端口 3309）
DATABASE_URL="mysql://yourusername:yourpassword@127.0.0.1:yourport/yourdb"
# 测试库连接串
DATABASE_URL_TEST="mysql://yourusername:yourpassword@127.0.0.1:yourport/yourdb_test"

# JWT 配置
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 前端地址（CORS 白名单）
CLIENT_ORIGIN=http://localhost:5173

# SMTP 邮件发送（163 邮箱，465 隐式 SSL）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM=your_email@163.com